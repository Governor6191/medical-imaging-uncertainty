# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage reports
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.hypothesis/
htmlcov/

# Jupyter
.ipynb_checkpoints

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# Editors / tooling caches
.ruff_cache/
.mypy_cache/
.idea/
.vscode/

# Datasets (downloaded locally, too large for git)
data/*
# Exception: keep the data folder README for documentation
!data/README.md

# Generated artifacts (regenerated by the scripts in scripts/)
outputs/**
# Exceptions: keep the folder structure and the small metrics records for reproducibility
!outputs/**/
!outputs/.gitkeep
!outputs/**/metrics.json
!outputs/**/comparison.json

# Model checkpoints (released via Hugging Face Hub, not tracked in git)
checkpoints/

# Local contributor notes
CLAUDE.md
RESUME.md

# BraTS demo sample slices (derived from BraTS data, kept out of git; the demo
# Space carries its own copy, regenerate locally with scripts/make_brats_samples.py)
demo_assets/brats_samples/
